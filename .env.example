# Copy this to .env and fill in your values.
# For Docker Compose, these defaults work out of the box.
# For local dev, change DATABASE_URL and REDIS_URL to point to your local instances.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/carevo?sslmode=disable
REDIS_URL=localhost:6379
JWT_SECRET=change-me-to-a-random-secret-but-why-would-i-amnt-i-god-amnt-igod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
PORT=8080

# AI — get a free API key at https://aistudio.google.com/apikey (Google account, no credit card)
# Leave empty to run without AI features.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
